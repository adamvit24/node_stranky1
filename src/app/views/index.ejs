<%- include('_partials/heads') %>

<header class="hero">
    <h1>Festival Hudby a Umění</h1>

    <p>Největší letní festival roku.</p>

    <div class="countdown">
        <h2>Festival začíná za:</h2>
        <div id="timer"></div>
    </div>
</header>

<section class="sponsors">
    <h2>Sponzoři</h2>

    <div class="sponsor-logos">
        <div>SPŠ Trutnov</div>
        <div>Hellstar</div>
        <div>BrarSound</div>
        <div>Skittles</div>
    </div>
</section>

<script>
const festivalDate = new Date("July 19, 2026 18:00:00").getTime();

const timer = setInterval(function() {

    const now = new Date().getTime();
    const distance = festivalDate - now;

    const days = Math.floor(distance / (1000*60*60*24));
    const hours = Math.floor((distance % (1000*60*60*24)) / (1000*60*60));
    const minutes = Math.floor((distance % (1000*60*60)) / (1000*60));

    document.getElementById("timer").innerHTML =
    days + " dní " + hours + " hodin " + minutes + " minut";

},1000);
</script>

