<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/style.css" />
    <title><%= prispevek ? prispevek.nadpis : 'Příspěvek nenalezen' %> - TrutnoFest 2026</title>
</head>
<body>
<nav class="navbar">
    <div class="logo">TrutnoFest 2026</div>

    <ul class="nav-links">
        <li><a href="/">Úvod</a></li>
        <li><a href="/posts">Příspěvky</a></li>
        <li><a href="/program">Program</a></li>
    </ul>
</nav>

    <main>
        <% if (prispevek) { %>
            <article>
                <h1><%= prispevek.nadpis %></h1>
                <p><%= prispevek.obsah %></p>
            </article>
        <% } else { %>
            <h1>Příspěvek nebyl nalezen</h1>
            <p>Požadovaný příspěvek neexistuje nebo byl smazán.</p>
        <% } %>

        <br>
        <a href="/posts">← Zpět na všechny příspěvky</a>
    </main>
</body>
</html>