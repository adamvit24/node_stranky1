<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/style.css" />
    <title><%= titulek %></title>
</head>
<body>
    <h1><%= titulek %></h1>
    <% if(typeof prispevky == 'undefined' || prispevky.length == 0) { %>
        <p><i>Dosud neexistují žádné příspěvky.</i></p>
    <% } else { %>
        <% for(let i = 0; i < prispevky.length; i++) { %>
            <div id="<%= prispevky[i].id %>">
                <h2><%= prispevky[i].nadpis %></h2>
                <p><%= prispevky[i].obsah %></p>
            </div>
        <% } %>
    <% } %>
</body>
</html>